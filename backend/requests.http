### AROGYINI API — VS Code REST Client
#
# Install: "REST Client" by Huachao Mao (humao.rest-client).
# Click "Send Request" above any ### block. Run them top to bottom the first time:
# signup/signin set @token, and several later blocks need @conversationId, @jobId etc.
#
# Variables captured from responses use the {{request.response.body.$.…}} syntax, so a block
# only works after the request it names has been sent in this session.

@host = http://localhost:3000/api
@contentType = application/json

# Credentials (change these, or match what you seeded)
@userName = Asha Rao
@userEmail = asha@example.com
@userPassword = Secret123
@adminEmail = admin@arogyini.in
@adminPassword = Admin@12345


# ===========================================================================
# HEALTH
# ===========================================================================

### Service health — no auth
GET {{host}}/health


### Unknown route, to see the error envelope
GET {{host}}/does-not-exist


# ===========================================================================
# AUTH
# ===========================================================================

### Sign up (always creates role "user"; a role in the body is ignored)
# @name signup
POST {{host}}/auth/signup
Content-Type: {{contentType}}

{
  "name": "{{userName}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}",
  "phone": "98765 43210",
  "city": "Pune",
  "bloodGroup": "B+",
  "role": "admin"
}


### Sign in as the user — captures @token
# @name signin
POST {{host}}/auth/signin
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

@token = {{signin.response.body.$.data.token}}


### Sign in as the admin — captures @adminToken
# @name adminSignin
POST {{host}}/auth/signin
Content-Type: {{contentType}}

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

@adminToken = {{adminSignin.response.body.$.data.token}}


### Wrong password — expect 401 with a generic message
POST {{host}}/auth/signin
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "password": "WrongPassword1"
}


### Current user
GET {{host}}/auth/me
Authorization: Bearer {{token}}


### Current user without a token — expect 401
GET {{host}}/auth/me


### Update own profile (name, phone, bloodGroup, city only)
PATCH {{host}}/auth/me
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "city": "Mumbai",
  "bloodGroup": "O+",
  "email": "hacker@example.com",
  "role": "admin"
}


### Change password (requires the current one).
### NOTE: running this invalidates @userPassword above — sign in again with the new one.
PATCH {{host}}/auth/password
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "currentPassword": "{{userPassword}}",
  "newPassword": "Brandnew1"
}


# ===========================================================================
# EMERGENCY CONTACTS (max 5 per user)
# ===========================================================================

### Add a contact — loose phone formats are normalised to E.164
# @name createContact
POST {{host}}/contacts
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Maa",
  "relation": "mother",
  "phone": "98765 43210",
  "priority": 1
}

@contactId = {{createContact.response.body.$.data.contact.id}}


### Add a second contact
POST {{host}}/contacts
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Papa",
  "relation": "father",
  "phone": "+91 90000 11111",
  "priority": 2
}


### List own contacts, ordered by priority
GET {{host}}/contacts
Authorization: Bearer {{token}}


### Update a contact
PATCH {{host}}/contacts/{{contactId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "relation": "guardian",
  "priority": 3
}


### Unusable phone number — expect 400
POST {{host}}/contacts
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Bad",
  "phone": "12345"
}


### Delete a contact — expect 204
DELETE {{host}}/contacts/{{contactId}}
Authorization: Bearer {{token}}


# ===========================================================================
# CYCLE TRACKER
# ===========================================================================

### Summary before any logs — hasData false with defaults
GET {{host}}/cycles/summary
Authorization: Bearer {{token}}


### Log a period (adjust the dates so the newest is recent)
# @name createCycle
POST {{host}}/cycles
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "startDate": "2026-08-04",
  "endDate": "2026-08-08",
  "flow": "medium",
  "symptoms": ["cramps", "fatigue"],
  "mood": "low",
  "notes": "Heavier than usual"
}

@cycleId = {{createCycle.response.body.$.data.log.id}}


### Second cycle, about 28 days later
POST {{host}}/cycles
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "startDate": "2026-09-01",
  "endDate": "2026-09-05",
  "flow": "heavy"
}


### Third cycle
POST {{host}}/cycles
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "startDate": "2026-09-29",
  "endDate": "2026-10-03",
  "flow": "light"
}


### List cycle logs, newest first
GET {{host}}/cycles?page=1&limit=10
Authorization: Bearer {{token}}


### Summary with data — predictions, phase, tips
GET {{host}}/cycles/summary
Authorization: Bearer {{token}}


### Overlapping log — expect 409 CYCLE_OVERLAP
POST {{host}}/cycles
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "startDate": "2026-09-03"
}


### Future start date — expect 400 FUTURE_START_DATE
POST {{host}}/cycles
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "startDate": "2099-01-01"
}


### Update a log
PATCH {{host}}/cycles/{{cycleId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "flow": "heavy",
  "symptoms": ["backache"]
}


### Delete a log — expect 204
DELETE {{host}}/cycles/{{cycleId}}
Authorization: Bearer {{token}}


# ===========================================================================
# SAFETY: SOS
# ===========================================================================

### Public helplines — no auth
GET {{host}}/safety/helplines


### Trigger SOS. Sends one SMS per contact (watch the dev terminal with
### SMS_PROVIDER=console). Needs at least one emergency contact, else 400 NO_CONTACTS.
# @name triggerSos
POST {{host}}/sos
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "latitude": 18.5204,
  "longitude": 73.8567,
  "accuracy": 12,
  "message": "Near the bus stand"
}

@sosId = {{triggerSos.response.body.$.data.event.id}}


### Trigger again — returns the SAME active event with alreadyActive true (200, not 201)
POST {{host}}/sos
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "latitude": 18.5204,
  "longitude": 73.8567
}


### Own SOS history, paginated
GET {{host}}/sos?page=1&limit=10
Authorization: Bearer {{token}}


### One SOS event
GET {{host}}/sos/{{sosId}}
Authorization: Bearer {{token}}


### Resolve, and send an "I'm safe" SMS to every contact
PATCH {{host}}/sos/{{sosId}}/resolve?notify=true
Authorization: Bearer {{token}}


### Cancel an active event (resolve/cancel on a closed one returns 404)
PATCH {{host}}/sos/{{sosId}}/cancel
Authorization: Bearer {{token}}


# ===========================================================================
# LEGAL
# ===========================================================================

### All published rights — public
GET {{host}}/legal/rights?page=1&limit=20


### Filter by category: workplace | domestic | marriage | cyber | criminal | media
GET {{host}}/legal/rights?category=workplace


### Search title, act name and summary
GET {{host}}/legal/rights?search=POSH


### One right by slug — public
GET {{host}}/legal/rights/posh-act-2013


### Unknown slug — expect 404
GET {{host}}/legal/rights/no-such-act-1999


