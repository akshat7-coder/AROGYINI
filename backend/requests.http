# ===========================================================================
# CAREER
# ===========================================================================

### Jobs — public, paginated
# @name jobs
GET {{host}}/career/jobs?page=1&limit=20

@jobId = {{jobs.response.body.$.data.0.id}}


### Filter by type: full-time | part-time | remote | returnship | internship
GET {{host}}/career/jobs?type=returnship


### Career-break-friendly roles only
GET {{host}}/career/jobs?careerBreakFriendly=true


### Search title, company and description
GET {{host}}/career/jobs?search=engineer


### Combined filters
GET {{host}}/career/jobs?type=returnship&careerBreakFriendly=true&search=engineer&page=1&limit=10


### One job — public (404 if inactive)
GET {{host}}/career/jobs/{{jobId}}


### Save a job (toggle: call again to unsave) — returns { saved: true|false }
POST {{host}}/career/jobs/{{jobId}}/save
Authorization: Bearer {{token}}


### Own saved jobs
GET {{host}}/career/saved
Authorization: Bearer {{token}}


### Apply to a job (409 ALREADY_APPLIED on a second attempt)
POST {{host}}/career/jobs/{{jobId}}/apply
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "coverNote": "I have five years of relevant experience and am returning from a career break."
}


### Own applications, with the job populated
GET {{host}}/career/applications?page=1&limit=20
Authorization: Bearer {{token}}


### Own applications filtered by status
GET {{host}}/career/applications?status=submitted
Authorization: Bearer {{token}}


### Scholarships — public, upcoming deadlines first
GET {{host}}/career/scholarships?page=1&limit=20


### Include expired ones (they sort after the upcoming)
GET {{host}}/career/scholarships?includeExpired=true


### Filter by domain
GET {{host}}/career/scholarships?domain=entrepreneurship


# ===========================================================================
# CHAT
# ===========================================================================

### Enabled bots for the picker
GET {{host}}/chat/bots
Authorization: Bearer {{token}}


### Start a conversation
# @name createConversation
POST {{host}}/chat/conversations
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{}

@conversationId = {{createConversation.response.body.$.data.conversation.id}}


### Own conversations, newest activity first
GET {{host}}/chat/conversations?page=1&limit=20
Authorization: Bearer {{token}}


### Health question — auto-routes to the medical bot (needs the Flask bot on :5000)
# @name sendHealth
POST {{host}}/chat/conversations/{{conversationId}}/messages
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "content": "my period is late and I have bad cramps",
  "bot": "auto"
}

@messageId = {{sendHealth.response.body.$.data.message.id}}


### Legal question — auto-routes to the legal bot (needs the FastAPI bot on :8002)
POST {{host}}/chat/conversations/{{conversationId}}/messages
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "content": "how do I file an FIR for dowry harassment"
}


### Explicit bot override — a health question forced to the legal bot
POST {{host}}/chat/conversations/{{conversationId}}/messages
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "content": "my period is late",
  "bot": "legal"
}


### General question — LLM, or the built-in fallback when LLM_API_KEY is empty
POST {{host}}/chat/conversations/{{conversationId}}/messages
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "content": "what can this app help me with",
  "bot": "general"
}


### Emergency — response has emergency true and the 112/181/1091 notice on top
POST {{host}}/chat/conversations/{{conversationId}}/messages
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "content": "bachao someone is following me"
}


### Empty message — expect 400
POST {{host}}/chat/conversations/{{conversationId}}/messages
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "content": "   "
}


### Conversation with its messages
GET {{host}}/chat/conversations/{{conversationId}}
Authorization: Bearer {{token}}


### Report an assistant message (creates a user_report ChatIssue)
POST {{host}}/chat/messages/{{messageId}}/report
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "reason": "This advice looks wrong and could be harmful."
}


### Delete a conversation, its messages and its issues — expect 204
DELETE {{host}}/chat/conversations/{{conversationId}}
Authorization: Bearer {{token}}


# ===========================================================================
# ADMIN — all require role "admin" (403 for a normal user)
# ===========================================================================

### Dashboard counts
GET {{host}}/admin/stats
Authorization: Bearer {{adminToken}}


### Admin route with a user token — expect 403
GET {{host}}/admin/stats
Authorization: Bearer {{token}}


# --- Users ---

### List users, paginated, searchable by name or email
# @name adminUsers
GET {{host}}/admin/users?page=1&limit=20&search=asha
Authorization: Bearer {{adminToken}}

@targetUserId = {{adminUsers.response.body.$.data.0.id}}


### Filter by role
GET {{host}}/admin/users?role=user
Authorization: Bearer {{adminToken}}


### Promote a user to admin
PATCH {{host}}/admin/users/{{targetUserId}}/role
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "role": "admin"
}


### Deactivate a user (they then get 403 on authenticated routes)
PATCH {{host}}/admin/users/{{targetUserId}}/status
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "isActive": false
}


### Reactivate
PATCH {{host}}/admin/users/{{targetUserId}}/status
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "isActive": true
}


# --- SOS oversight ---

### All SOS events, with the user populated
# @name adminSos
GET {{host}}/admin/sos?page=1&limit=20
Authorization: Bearer {{adminToken}}

@adminSosId = {{adminSos.response.body.$.data.0.id}}


### Filter by status: active | resolved | cancelled
GET {{host}}/admin/sos?status=active
Authorization: Bearer {{adminToken}}


### Resolve any user's SOS event
PATCH {{host}}/admin/sos/{{adminSosId}}/resolve
Authorization: Bearer {{adminToken}}


# --- Legal content ---

### All legal rights, including unpublished ones
GET {{host}}/admin/legal?page=1&limit=20
Authorization: Bearer {{adminToken}}


### Only the unpublished ones (how to find a right you hid)
GET {{host}}/admin/legal?isPublished=false
Authorization: Bearer {{adminToken}}


### Create a legal right
# @name adminCreateLegal
POST {{host}}/admin/legal
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "slug": "example-act-2026",
  "title": "An Example Protection",
  "actName": "Example Protection Act",
  "year": 2026,
  "category": "criminal",
  "summary": "A summary long enough to be meaningful, describing what this example law protects against.",
  "keyProtections": ["Section 1: something protective."],
  "howToFile": ["Write a complaint.", "Submit it at the police station."],
  "penalties": "Up to one year of imprisonment and a fine.",
  "helplines": ["112", "181"],
  "faqs": [{ "q": "Who does this cover?", "a": "Anyone affected." }]
}

@legalId = {{adminCreateLegal.response.body.$.data.right.id}}


### Update it (isPublished false hides it from the public endpoints)
PATCH {{host}}/admin/legal/{{legalId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "title": "An Updated Example Protection",
  "isPublished": false
}


### Delete it — expect 204
DELETE {{host}}/admin/legal/{{legalId}}
Authorization: Bearer {{adminToken}}


# --- Jobs ---

### List jobs including inactive ones
GET {{host}}/admin/jobs?page=1&limit=20
Authorization: Bearer {{adminToken}}


### Only inactive jobs
GET {{host}}/admin/jobs?isActive=false
Authorization: Bearer {{adminToken}}


### Create a job
# @name adminCreateJob
POST {{host}}/admin/jobs
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "title": "Backend Engineer",
  "company": "Example Works",
  "location": "Remote (India)",
  "type": "remote",
  "category": "engineering",
  "salaryRange": "Approx Rs 18,00,000 - 25,00,000 per year",
  "experienceLevel": "3-6 years",
  "description": "Build and run HTTP services for a small product team, with on-call shared across four people.",
  "requirements": ["3 years with Node.js or Python", "Comfort with SQL"],
  "benefits": ["Fully remote", "26 weeks paid maternity leave"],
  "careerBreakFriendly": true,
  "applyUrl": "https://example.com/careers/backend"
}

@adminJobId = {{adminCreateJob.response.body.$.data.job.id}}


### Update a job
PATCH {{host}}/admin/jobs/{{adminJobId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "salaryRange": "Approx Rs 20,00,000 - 28,00,000 per year",
  "isActive": true
}


### Applications for a job, with the applicant populated
GET {{host}}/admin/jobs/{{jobId}}/applications?page=1&limit=20
Authorization: Bearer {{adminToken}}


### Applications for a job, filtered by status
GET {{host}}/admin/jobs/{{jobId}}/applications?status=submitted
Authorization: Bearer {{adminToken}}


### Delete a job (also deletes its applications) — expect 204
DELETE {{host}}/admin/jobs/{{adminJobId}}
Authorization: Bearer {{adminToken}}


# --- Applications ---

